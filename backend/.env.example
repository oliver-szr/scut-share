# Relative paths are always resolved from backend/, independent of shell cwd.
DATABASE_PATH=data/scut_share.db
# JSON array; exact local frontend origins only, never a wildcard.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Local HTTP only. Production requires HTTPS origins and Secure cookies.
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=scut_share_session
# Absolute session lifetime: 7 days; changing it affects new sessions only.
SESSION_TTL_SECONDS=604800
# Controlled local directory for validated item images.
UPLOAD_DIR=data/uploads
MAX_IMAGE_BYTES=5242880
